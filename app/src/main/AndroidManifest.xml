<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <permission
        android:name="com.btf.rk3568_hdmi_mediaplay.permission.SEND_PLAYER_COMMAND"
        android:protectionLevel="signature" />

    <permission
        android:name="com.btf.rk3568_hdmi_mediaplay.permission.RECEIVE_PLAYER_STATUS"
        android:protectionLevel="signature" />

    <!-- 存储权限。minSdk=30（Android 11），读写U盘走 MANAGE_EXTERNAL_STORAGE；
         WRITE_EXTERNAL_STORAGE 带 maxSdkVersion=29，在 minSdk 30 上永远不生效，已移除。 -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- USB权限 -->
    <uses-permission android:name="android.permission.USB_PERMISSION" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <!-- 开机自启动 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 前台服务 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Android 13+（API 33）起通知需运行时授权：UsbMonitorService 是前台服务，
         没有此权限时其常驻通知不显示，用户无法得知U盘监听正在运行。
         注意：用户拒绝只影响通知可见性，前台服务本身照常运行。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    
    <!-- 悬浮窗权限。
         用途：**仅**用于「进程被 LMK 杀掉后把 kiosk 界面拉回前台」。
         Android 11 对后台启动 Activity 有严格限制，实测 AlarmManager +
         PendingIntent 仍被判 isBgStartWhitelisted=false 而拦截；
         持有 SYSTEM_ALERT_WINDOW 是该限制的官方豁免条件之一。
         本应用不创建任何悬浮窗 UI。 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- 屏幕常亮 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".MediaPlayApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Rk3568_hdmi_mediaplay"
        android:largeHeap="true"
        android:hardwareAccelerated="true"
        tools:targetApi="31">
        
        <!-- 主Activity - 全屏配置 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Rk3568_hdmi_mediaplay.Fullscreen"
            android:screenOrientation="unspecified"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        
        <!-- 开机广播接收器 -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
        
        <!-- USB 广播接收器。
             2026-10-20 安全修复：
             `MEDIA_MOUNTED` 等是**隐式广播**，任何应用（含普通第三方 apk）
             都能 `sendBroadcast` 伪造它 —— 实测可让本应用对
             `/mnt/media_rw/EVIL` 走完整 U 盘处理链。
             服务内已有**动态注册**（RECEIVER_NOT_EXPORTED），
             因此静态声明是冗余的攻击面，直接去掉。
             若将来需要在服务未运行时收挂载事件，应改用
             `android:permission` 或校验 `intent.data` 的挂载根，而不是裸导出。 -->
        <receiver
            android:name=".receiver.UsbBroadcastReceiver"
            android:enabled="true"
            android:exported="false" />
        
        <!-- 远程控制命令接收器 -->
        <receiver
            android:name=".receiver.PlayerCommandReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="com.btf.rk3568_hdmi_mediaplay.permission.SEND_PLAYER_COMMAND">
            <intent-filter>
                <action android:name="com.btf.player.action.COMMAND" />
            </intent-filter>
        </receiver>
        
        <!-- U盘监听服务 -->
        <service
            android:name=".service.UsbMonitorService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>

</manifest>
